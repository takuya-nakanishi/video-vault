{
  "name": "video-vault-web",
  "private": true,
  "version": "0.1.0",
  "description": "ゲットVIDEO の PC 版。手元の PC で動かし、アプリが開くブラウザでログインして yt-dlp で取得する(公開しない)",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
